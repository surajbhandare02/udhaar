# Server Configuration
PORT=3000
NODE_ENV=production

# Public URL Security (Dashboard PIN & Shortcuts Secret)
APP_PIN=1234
WEBHOOK_SECRET=your_super_secret_webhook_token_here

# Persistent 24/7 Cloud Database (Turso Free Tier)
# Get yours for free at https://turso.tech
# Leave empty for offline local SQLite fallback (./udhaar.db)
TURSO_DATABASE_URL=libsql://your-db-name.turso.io
TURSO_AUTH_TOKEN=your_turso_auth_token_here
